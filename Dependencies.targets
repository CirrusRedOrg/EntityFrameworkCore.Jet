<Project>
	<PropertyGroup>
		<DotNetVersion>[11.0.0-rc.1.26425.128]</DotNetVersion>
		<EFCoreVersion>[11.0.0-rc.1.26425.128]</EFCoreVersion>
		<MSLibVersion>[11.0.0-rc.1.26425.128]</MSLibVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Common -->
		<PackageReference Update="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MSLibVersion)" />
		<PackageReference Update="Microsoft.Extensions.Configuration.Json" Version="$(MSLibVersion)" />
		<PackageReference Update="Microsoft.EntityFrameworkCore" Version="$(EFCoreVersion)" />
		<PackageReference Update="Microsoft.EntityFrameworkCore.Relational" Version="$(EFCoreVersion)" />
		<PackageReference Update="DotNetAnalyzers.DocumentationAnalyzers" Version="1.0.0-beta.59" />
		<PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.1.26425.128" />

		<!-- EFCore.Jet -->
		<PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="$(MSLibVersion)" />
		<PackageReference Update="Microsoft.Extensions.Configuration" Version="$(MSLibVersion)" />
		<PackageReference Update="Microsoft.Extensions.Logging" Version="$(MSLibVersion)" />

		<!-- Tests -->
		<PackageReference Update="System.Data.Odbc" Version="$(MSLibVersion)" />
		<PackageReference Update="System.Data.OleDb" Version="$(MSLibVersion)" />
		<PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="$(EFCoreVersion)" />
		<PackageReference Update="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="$(EFCoreVersion)" />
		<PackageReference Update="Microsoft.Extensions.Logging.Console" Version="$(MSLibVersion)" />
		<PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.10.0" />
		<!-- Centralised so the three test projects that use it cannot drift apart again; they previously
		     carried inline 18.7.1 / 18.7.1 / 18.4.0. -->
		<PackageReference Update="Microsoft.Build.Tasks.Core" Version="18.9.6" />
		<PackageReference Update="MSTest.TestAdapter" Version="4.4.0" />
		<PackageReference Update="MSTest.TestFramework" Version="4.4.0" />
		<PackageReference Update="coverlet.collector" Version="10.0.1" />

		<!-- EFCore.Jet.FunctionalTests -->
		<!-- xunit v3. Not a preference: EF 11's Relational.Specification.Tests depends on
		     Microsoft.DotNet.XUnitV3Extensions, so inheriting from its test bases requires v3. Pinned to the
		     same build EF resolves, so the two cannot disagree about which xunit is in the graph. -->
		<PackageReference Update="xunit.v3.core" Version="4.0.0" />
		<PackageReference Update="xunit.v3.assert" Version="4.0.0" />
		<PackageReference Update="xunit.v3.extensibility.core" Version="4.0.0" />
		<PackageReference Update="xunit.runner.visualstudio" Version="4.0.0" />
		<PackageReference Update="Microsoft.Extensions.Configuration.FileExtensions" Version="$(MSLibVersion)" />
		<PackageReference Update="NetTopologySuite" Version="2.6.0" />

		<!-- LibRed.Benchmarks -->
		<PackageReference Update="BenchmarkDotNet" Version="0.15.8" />

		<!-- EFCore.Jet.Tests -->
		<PackageReference Update="Microsoft.Extensions.DependencyModel" Version="$(MSLibVersion)" />
		<PackageReference Update="Moq" Version="4.20.72" />
	</ItemGroup>
</Project>