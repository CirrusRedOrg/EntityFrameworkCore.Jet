<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(JetTargetFramework)</TargetFramework>
    <RootNamespace>LibRed</RootNamespace>
    <AssemblyName>LibRed.Core</AssemblyName>
    <Description>Native, fully managed reader/writer for the Microsoft Jet/ACE (Access MDB/ACCDB) file format: pages, tables, columns, indexes, catalog, encoding and memo/OLE fields.</Description>
    <Platforms>AnyCPU;x86;x64</Platforms>
  </PropertyGroup>


  <ItemGroup>
    <!-- The sort-key generators measure ACE and rewrite the resources below, so they need to reach the
         encoder internals — in particular the switch that makes a generator read the bare table. -->
    <InternalsVisibleTo Include="LibRed.Core.Tests, " />
  </ItemGroup>

  <ItemGroup>
    <!-- The "General" (v1) sorting weight table, built by tools\sortkey-table\generate.ps1 from Microsoft's
         published Windows Server 2008 table (linked from [MS-UCODEREF]). -->
    <EmbeddedResource Include="Resources\SortKeyTableV1.bin" LogicalName="LibRed.Resources.SortKeyTableV1.bin" />
    <!-- The "General legacy" (v0) weights. No published table exists for these — v0's primaries are a
         Jet-specific compaction of the NT4-era order — so they are measured from ACE itself by
         SortKeyTableV0GeneratorTest (LIBRED_GENERATE_V0=1). -->
    <EmbeddedResource Include="Resources\SortKeyTableV0.bin" LogicalName="LibRed.Resources.SortKeyTableV0.bin" />
    <!-- The characters where ACE's v1 weights disagree with the published Server 2008 table — scripts added
         or reweighted since. Measured by SortKeyTableV1OverrideGeneratorTest (LIBRED_GENERATE_V1=1). -->
    <EmbeddedResource Include="Resources\SortKeyTableV1Overrides.bin" LogicalName="LibRed.Resources.SortKeyTableV1Overrides.bin" />
  </ItemGroup>

</Project>
