<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- dotnet11 replaces the old dotnet9 entry, which only ever carried 9.x and had nothing this repo
         pins. The EF preview packages - including Relational.Specification.Tests - are all on nuget.org
         too, so this feed is a mirror rather than a requirement. -->
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
    <!-- Arcade's test helpers. Microsoft.DotNet.XUnitV3Extensions is a transitive dependency of EF 11's
         Relational.Specification.Tests and is published here only - never to nuget.org - so without this
         feed the three suites that inherit EF's test bases fail to restore with NU1101. -->
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />

    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>