<Project>
  <!--
    The LibRed.* projects are a from-scratch, fully managed implementation of the
    Jet/ACE (Access MDB/ACCDB) engine. Unlike the ODBC/OleDb-based EFCore.Jet
    projects, they have NO Windows dependency and must stay cross-platform.
    [SupportedOSPlatform("windows")] is applied by each driver-bound project itself,
    so nothing here needs to opt out of it.

  -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Keep strong-naming consistent with the rest of the repository. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\Key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!--
    The repo-root props packs docs\README.md as every package's readme, which is the Jet provider's page -
    it opens with "requires Windows" and an ACE driver, neither of which applies here. Swap in a LibRed one.
    PackagePath carries a file name, so it is packed AS README.md and the inherited PackageReadmeFile
    property still resolves. The Remove has to name the same file the root props included, by a path
    relative to this one.
  -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\docs\README.md" />
    <None Include="$(MSBuildThisFileDirectory)PackageReadme.md" Pack="true" PackagePath="\README.md" Visible="false" />
  </ItemGroup>
</Project>
