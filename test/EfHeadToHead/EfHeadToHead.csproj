<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scratch probe: the same EF Core queries through EFCore.Jet (OLE DB / ACE) and LibRed.EFCore, timed by stage.
       A real project rather than a file-based app, because System.Data.OleDb will not bind in a file-based app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="D:\toolkits\efcorejetlibred\src\EFCore.Jet\EFCore.Jet.csproj" />
    <ProjectReference Include="D:\toolkits\efcorejetlibred\src\LibRed\LibRed.EFCore\LibRed.EFCore.csproj" />
    <PackageReference Include="System.Data.OleDb" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>

</Project>
